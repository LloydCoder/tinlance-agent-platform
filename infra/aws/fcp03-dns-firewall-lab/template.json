{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "FCP-03 Workstream B near-zero-cost DNS Firewall lab. No Network Firewall, no NAT Gateway, no public worker IP. Route 53 DNS Firewall allowlist + fail-closed, strict SG/NACL with VPC-Resolver-only DNS and full UDP/TCP return path, Gateway Endpoints with deny-by-default policies (no worker instance profile). Disposable single-AZ. Not production. Do not deploy without cost-gate approval.",
  "Parameters": {
    "AvailabilityZone": {
      "Type": "AWS::EC2::AvailabilityZone::Name",
      "Description": "Single AZ for the disposable DNS-Firewall lab."
    },
    "ApprovedDomains": {
      "Type": "CommaDelimitedList",
      "Description": "FQDN allowlist for DNS resolution (no protocol prefixes). First entry is the approved probe domain. Must not include BlockedProbeDomain."
    },
    "BlockedProbeDomain": {
      "Type": "String",
      "Description": "Known-resolvable FQDN omitted from ApprovedDomains; DNS Firewall must return NXDOMAIN for it.",
      "MinLength": 3,
      "MaxLength": 253,
      "AllowedPattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\\.[a-zA-Z]{2,}$"
    },
    "TeardownAtUtc": {
      "Type": "String",
      "Description": "UTC timestamp (YYYY-MM-DDTHH:MM:SS) when EventBridge Scheduler deletes this stack. Required; no default.",
      "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "WorkerInstanceType": {
      "Type": "String",
      "Default": "t4g.nano",
      "AllowedValues": [
        "t4g.nano",
        "t3.nano",
        "t4g.micro"
      ]
    },
    "WorkerAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
    },
    "VpcCidr": {
      "Type": "String",
      "Default": "10.43.0.0/16",
      "AllowedValues": [
        "10.43.0.0/16"
      ]
    },
    "WorkerSubnetCidr": {
      "Type": "String",
      "Default": "10.43.1.0/24",
      "AllowedValues": [
        "10.43.1.0/24"
      ]
    },
    "VpcResolverCidr": {
      "Type": "String",
      "Default": "10.43.0.2/32",
      "AllowedValues": [
        "10.43.0.2/32"
      ],
      "Description": "Amazon Route 53 Resolver (VPC base+2). DNS egress restricted to this destination only."
    }
  },
  "Rules": {
    "BlockedProbeMustNotBeApproved": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  {
                    "Ref": "ApprovedDomains"
                  },
                  {
                    "Ref": "BlockedProbeDomain"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "BlockedProbeDomain must not appear in ApprovedDomains."
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": {
          "Ref": "VpcCidr"
        },
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-vpc"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "FCPWorkstream",
            "Value": "B-dns-firewall-lab"
          }
        ]
      }
    },
    "WorkerSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": {
          "Ref": "WorkerSubnetCidr"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WorkerRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker-rt"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WorkerRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "RouteTableId": {
          "Ref": "WorkerRouteTable"
        }
      }
    },
    "S3GatewayEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.s3"
        },
        "VpcEndpointType": "Gateway",
        "RouteTableIds": [
          {
            "Ref": "WorkerRouteTable"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyAllWithoutCredentials",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "*",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "DynamoDBGatewayEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.dynamodb"
        },
        "VpcEndpointType": "Gateway",
        "RouteTableIds": [
          {
            "Ref": "WorkerRouteTable"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyAllWithoutCredentials",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "*",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "WorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "FCP-03 DNS lab: no ingress; DNS only to VPC Resolver 10.43.0.2/32",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "udp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": {
              "Ref": "VpcResolverCidr"
            },
            "Description": "DNS UDP only to Amazon Route 53 Resolver (VPC base+2)"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": {
              "Ref": "VpcResolverCidr"
            },
            "Description": "DNS TCP only to Amazon Route 53 Resolver (VPC base+2)"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker-sg"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WorkerNetworkAcl": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker-nacl"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WorkerNetworkAclAssociation": {
      "Type": "AWS::EC2::SubnetNetworkAclAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        }
      }
    },
    "WorkerNaclEgressDhcp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 90,
        "Protocol": 17,
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Ref": "VpcCidr"
        },
        "PortRange": {
          "From": 67,
          "To": 68
        }
      }
    },
    "WorkerNaclEgressDnsUdp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 100,
        "Protocol": 17,
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Ref": "VpcResolverCidr"
        },
        "PortRange": {
          "From": 53,
          "To": 53
        }
      }
    },
    "WorkerNaclEgressDnsTcp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 110,
        "Protocol": 6,
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Ref": "VpcResolverCidr"
        },
        "PortRange": {
          "From": 53,
          "To": 53
        }
      }
    },
    "WorkerNaclEgressDenyRest": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 200,
        "Protocol": -1,
        "RuleAction": "deny",
        "Egress": true,
        "CidrBlock": "0.0.0.0/0"
      }
    },
    "WorkerNaclIngressDhcp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 90,
        "Protocol": 17,
        "RuleAction": "allow",
        "Egress": false,
        "CidrBlock": {
          "Ref": "VpcCidr"
        },
        "PortRange": {
          "From": 67,
          "To": 68
        }
      }
    },
    "WorkerNaclIngressDnsUdp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 100,
        "Protocol": 17,
        "RuleAction": "allow",
        "Egress": false,
        "CidrBlock": {
          "Ref": "VpcResolverCidr"
        },
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    },
    "WorkerNaclIngressDnsTcp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 110,
        "Protocol": 6,
        "RuleAction": "allow",
        "Egress": false,
        "CidrBlock": {
          "Ref": "VpcResolverCidr"
        },
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    },
    "WorkerNaclIngressDenyRest": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 200,
        "Protocol": -1,
        "RuleAction": "deny",
        "Egress": false,
        "CidrBlock": "0.0.0.0/0"
      }
    },
    "ApprovedDnsDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-approved-dns"
        },
        "Domains": {
          "Ref": "ApprovedDomains"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WildcardDnsDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-all-dns"
        },
        "Domains": [
          "*"
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "DNSFirewallRuleGroup": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-dns-allowlist"
        },
        "FirewallRules": [
          {
            "Action": "ALLOW",
            "FirewallDomainListId": {
              "Fn::GetAtt": [
                "ApprovedDnsDomainList",
                "Id"
              ]
            },
            "Priority": 100
          },
          {
            "Action": "BLOCK",
            "BlockResponse": "NXDOMAIN",
            "FirewallDomainListId": {
              "Fn::GetAtt": [
                "WildcardDnsDomainList",
                "Id"
              ]
            },
            "Priority": 200
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-dns-lab"
          }
        ]
      }
    },
    "DNSFirewallAssociation": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroupAssociation",
      "Properties": {
        "FirewallRuleGroupId": {
          "Ref": "DNSFirewallRuleGroup"
        },
        "VpcId": {
          "Ref": "Vpc"
        },
        "Priority": 101,
        "MutationProtection": "DISABLED",
        "Name": {
          "Fn::Sub": "${AWS::StackName}-dns-association"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "DNSFirewallConfig": {
      "Type": "AWS::Route53Resolver::FirewallConfig",
      "DependsOn": "DNSFirewallAssociation",
      "Properties": {
        "ResourceId": {
          "Ref": "Vpc"
        },
        "FirewallFailOpen": "DISABLED"
      }
    },
    "WorkerInstance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "DNSFirewallConfig",
        "S3GatewayEndpoint",
        "DynamoDBGatewayEndpoint",
        "DNSQueryLoggingAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "WorkerAmiId"
        },
        "InstanceType": {
          "Ref": "WorkerInstanceType"
        },
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WorkerSecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpEndpoint": "disabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 8,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": [
              "#!/bin/bash\nset -uo pipefail\necho FCP03_DNS_LAB_BOOTSTRAP_START\nAPPROVED=\"${ApprovedProbeDomain}\"\nBLOCKED=\"${BlockedProbeDomain}\"\nRESOLVER=\"10.43.0.2\"\nif ! command -v dig >/dev/null 2>&1; then\n  echo FCP03_TEST_DNS_APPROVED=INCONCLUSIVE_MISSING_DIG\n  echo FCP03_TEST_DNS_BLOCKED=INCONCLUSIVE_MISSING_DIG\n  echo FCP03_TEST_EXTERNAL_RESOLVER=INCONCLUSIVE_MISSING_DIG\n  echo FCP03_DNS_LAB_BOOTSTRAP_END\n  exit 0\nfi\nAPPROVED_OUT=$(dig @\"$RESOLVER\" +time=2 +tries=1 +noidnin +noidnout \"$APPROVED\" A 2>&1) || true\nAPPROVED_STATUS=$(echo \"$APPROVED_OUT\" | awk '/status:/{print $6}' | tr -d ',')\nAPPROVED_ANS=$(echo \"$APPROVED_OUT\" | awk '/ANSWER SECTION/{flag=1;next}/SECTION/{flag=0}flag' | grep -c 'IN[[:space:]]A[[:space:]]' || true)\nif [ \"$APPROVED_STATUS\" = \"NOERROR\" ] && [ \"$APPROVED_ANS\" -ge 1 ]; then\n  echo FCP03_TEST_DNS_APPROVED=PASS\nelif [ -z \"$APPROVED_STATUS\" ]; then\n  echo FCP03_TEST_DNS_APPROVED=INCONCLUSIVE_RESOLVER_UNREACHABLE_OR_TIMEOUT\nelse\n  echo FCP03_TEST_DNS_APPROVED=FAIL_STATUS_$APPROVED_STATUS\nfi\nBLOCKED_OUT=$(dig @\"$RESOLVER\" +time=2 +tries=1 +noidnin +noidnout \"$BLOCKED\" A 2>&1) || true\nBLOCKED_STATUS=$(echo \"$BLOCKED_OUT\" | awk '/status:/{print $6}' | tr -d ',')\nif [ \"$BLOCKED_STATUS\" = \"NXDOMAIN\" ]; then\n  echo FCP03_TEST_DNS_BLOCKED=PASS\nelif [ -z \"$BLOCKED_STATUS\" ]; then\n  echo FCP03_TEST_DNS_BLOCKED=INCONCLUSIVE_RESOLVER_UNREACHABLE_OR_TIMEOUT\nelif [ \"$BLOCKED_STATUS\" = \"NOERROR\" ]; then\n  echo FCP03_TEST_DNS_BLOCKED=FAIL_UNEXPECTED_RESOLUTION\nelse\n  echo FCP03_TEST_DNS_BLOCKED=INCONCLUSIVE_STATUS_$BLOCKED_STATUS\nfi\nif timeout 3 dig @8.8.8.8 +time=1 +tries=1 +noidnin example.com A >/dev/null 2>&1; then\n  echo FCP03_TEST_EXTERNAL_RESOLVER=FAIL_REACHABLE\nelse\n  echo FCP03_TEST_EXTERNAL_RESOLVER=PASS\nfi\necho FCP03_DNS_LAB_BOOTSTRAP_END\n",
              {
                "ApprovedProbeDomain": {
                  "Fn::Select": [
                    0,
                    {
                      "Ref": "ApprovedDomains"
                    }
                  ]
                },
                "BlockedProbeDomain": {
                  "Ref": "BlockedProbeDomain"
                }
              }
            ]
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "FCPWorkstream",
            "Value": "B-dns-firewall-lab"
          }
        ]
      }
    },
    "TeardownRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeleteThisStackOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DeleteStack",
                    "cloudformation:DescribeStacks"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${AWS::StackName}/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "AutomaticTeardown": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-teardown"
        },
        "Description": "Automatic delete of this FCP-03 DNS Firewall lab stack only",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "ScheduleExpression": {
          "Fn::Sub": "at(${TeardownAtUtc})"
        },
        "ScheduleExpressionTimezone": "UTC",
        "Target": {
          "Arn": "arn:aws:scheduler:::aws-sdk:cloudformation:deleteStack",
          "RoleArn": {
            "Fn::GetAtt": [
              "TeardownRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"StackName\":\"${AWS::StackName}\"}"
          }
        }
      }
    },
    "DNSQueryLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/route53resolver/${AWS::StackName}"
        },
        "RetentionInDays": 1
      },
      "Metadata": {
        "checkov": {
          "skip": [
            {
              "id": "CKV_AWS_158",
              "comment": "The disposable DNS lab uses CloudWatch Logs default AWS-owned encryption to avoid a separate billable CMK; one-day retention bounds stored evidence. Production logging must use a customer-managed key."
            }
          ]
        }
      }
    },
    "DNSQueryLogResourcePolicy": {
      "Type": "AWS::Logs::ResourcePolicy",
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${AWS::StackName}-resolver-query-logs"
        },
        "PolicyDocument": {
          "Fn::Sub": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"route53resolver.amazonaws.com\"},\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":\"${DNSQueryLogGroup.Arn}:*\",\"Condition\":{\"StringEquals\":{\"aws:SourceAccount\":\"${AWS::AccountId}\"}}}]}"
        }
      }
    },
    "DNSQueryLoggingConfig": {
      "Type": "AWS::Route53Resolver::ResolverQueryLoggingConfig",
      "DependsOn": "DNSQueryLogResourcePolicy",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-resolver-query-logs"
        },
        "DestinationArn": {
          "Fn::GetAtt": [
            "DNSQueryLogGroup",
            "Arn"
          ]
        }
      }
    },
    "DNSQueryLoggingAssociation": {
      "Type": "AWS::Route53Resolver::ResolverQueryLoggingConfigAssociation",
      "Properties": {
        "ResolverQueryLogConfigId": {
          "Ref": "DNSQueryLoggingConfig"
        },
        "ResourceId": {
          "Ref": "Vpc"
        }
      }
    }
  },
  "Outputs": {
    "WorkerInstanceId": {
      "Description": "Disposable worker; retrieve console with ec2:GetConsoleOutput",
      "Value": {
        "Ref": "WorkerInstance"
      }
    },
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "VpcResolverAddress": {
      "Description": "Route 53 Resolver used by SG/NACL DNS rules",
      "Value": {
        "Ref": "VpcResolverCidr"
      }
    },
    "DNSFirewallRuleGroupId": {
      "Value": {
        "Ref": "DNSFirewallRuleGroup"
      }
    },
    "AutomaticTeardownAtUtc": {
      "Value": {
        "Ref": "TeardownAtUtc"
      }
    },
    "SafetyNote": {
      "Value": "Near-zero-cost DNS Firewall lab only. No Network Firewall/NAT/public IP. Gateway endpoints deny-all. Not production. Confirm DELETE_COMPLETE after teardown. Do not claim live DNS Firewall qualification without deployment evidence."
    }
  }
}
