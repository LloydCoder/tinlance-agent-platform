{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Single-AZ disposable FCP-03 egress enforcement lab. Requires a bounded UTC teardown time; never deploy into a production VPC.",
  "Parameters": {
    "AvailabilityZone": {
      "Type": "AWS::EC2::AvailabilityZone::Name",
      "Description": "Must match the existing controller subnet AZ; one AZ only."
    },
    "ApprovedDomains": {
      "Type": "CommaDelimitedList",
      "Description": "Exact approved FQDNs for the controlled egress test; the worker is managed by SSH from the existing controller, not Systems Manager."
    },
    "TeardownAtUtc": {
      "Type": "String",
      "Description": "Required UTC timestamp YYYY-MM-DDTHH:MM:SS. Validate with scripts/validate_fcp03_teardown_at.py; must be 15 minutes to 2 hours after deployment."
    },
    "WorkerInstanceType": {
      "Type": "String",
      "Default": "t4g.medium",
      "AllowedValues": [
        "t4g.micro",
        "t4g.small",
        "t4g.medium"
      ]
    },
    "WorkerAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
    },
    "VpcCidr": {
      "Type": "String",
      "AllowedPattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$",
      "Description": "CIDR of the existing VPC; preflight verifies it matches VpcId."
    },
    "FirewallSubnetCidr": {
      "Type": "String",
      "AllowedPattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$",
      "Description": "Unused non-overlapping /24 CIDR for the Network Firewall endpoint subnet in the existing VPC."
    },
    "WorkerSubnetCidr": {
      "Type": "String",
      "AllowedPattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$",
      "Description": "Unused non-overlapping /24 CIDR for the private worker subnet in the existing VPC."
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Description": "Existing non-production VPC containing the SSM-managed FCP-03 controller."
    },
    "ControllerSubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Existing public subnet of the SSM-managed controller; its route table association is temporarily managed by this stack and restored on teardown."
    },
    "ControllerPrivateIp": {
      "Type": "String",
      "AllowedPattern": "^\\d{1,3}(\\.\\d{1,3}){3}$",
      "Description": "Private IPv4 address of the existing controller; used for the SSH management exception."
    },
    "ControllerSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id",
      "Description": "Existing controller security group; worker SSH ingress is restricted to this group."
    },
    "ControllerPublicKey": {
      "Type": "String",
      "MinLength": 80,
      "MaxLength": 800,
      "AllowedPattern": "^ssh-ed25519 [A-Za-z0-9+/=]+ [A-Za-z0-9._@-]+$",
      "Description": "Ephemeral Ed25519 public key generated and retained on the existing controller."
    },
    "InternetGatewayId": {
      "Type": "String",
      "AllowedPattern": "^igw-[0-9a-f]+$",
      "Description": "Existing Internet Gateway already attached to VpcId."
    },
    "VpcResolverIp": {
      "Type": "String",
      "AllowedPattern": "^\\d{1,3}(\\.\\d{1,3}){3}$",
      "Description": "Existing VPC Route 53 Resolver address (VPC primary CIDR base address + 2); preflight verifies it."
    }
  },
  "Resources": {
    "FirewallSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "CidrBlock": {
          "Ref": "FirewallSubnetCidr"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-firewall"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WorkerSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "CidrBlock": {
          "Ref": "WorkerSubnetCidr"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker-private"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        }
      }
    },
    "FirewallRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        }
      }
    },
    "WorkerRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        }
      }
    },
    "PublicRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "ControllerSubnetId"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      },
      "DependsOn": [
        "PublicDefaultRoute",
        "PublicReturnRoute"
      ]
    },
    "FirewallRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "FirewallSubnet"
        },
        "RouteTableId": {
          "Ref": "FirewallRouteTable"
        }
      }
    },
    "WorkerRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "RouteTableId": {
          "Ref": "WorkerRouteTable"
        }
      }
    },
    "PublicDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGatewayId"
        }
      }
    },
    "NatEip": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "DependsOn": "PublicDefaultRoute",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatEip",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "ControllerSubnetId"
        },
        "ConnectivityType": "public",
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "FirewallDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "NatGateway",
      "Properties": {
        "RouteTableId": {
          "Ref": "FirewallRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatGateway"
        }
      }
    },
    "WorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "FCP-03 worker: no ingress; DNS only to VPC resolver; HTTPS egress is inspected by Network Firewall.",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "SourceSecurityGroupId": {
              "Ref": "ControllerSecurityGroupId"
            },
            "Description": "SSH management only from the existing SSM-managed controller"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS routed through Network Firewall"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": {
              "Fn::Sub": "${VpcResolverIp}/32"
            },
            "Description": "VPC Resolver only"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": {
              "Fn::Sub": "${VpcResolverIp}/32"
            },
            "Description": "VPC Resolver TCP fallback only"
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "ApprovedDnsDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-approved-dns"
        },
        "Domains": {
          "Ref": "ApprovedDomains"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WildcardDnsDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-all-dns"
        },
        "Domains": [
          "*"
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "DNSFirewallRuleGroup": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-dns-allowlist"
        },
        "FirewallRules": [
          {
            "Action": "ALLOW",
            "FirewallDomainListId": {
              "Fn::GetAtt": [
                "ApprovedDnsDomainList",
                "Id"
              ]
            },
            "Priority": 100
          },
          {
            "Action": "BLOCK",
            "BlockResponse": "NXDOMAIN",
            "FirewallDomainListId": {
              "Fn::GetAtt": [
                "WildcardDnsDomainList",
                "Id"
              ]
            },
            "Priority": 200
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "DNSFirewallAssociation": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroupAssociation",
      "Properties": {
        "FirewallRuleGroupId": {
          "Ref": "DNSFirewallRuleGroup"
        },
        "VpcId": {
          "Ref": "VpcId"
        },
        "Priority": 101,
        "MutationProtection": "DISABLED",
        "Name": {
          "Fn::Sub": "${AWS::StackName}-dns-association"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "DNSFirewallConfig": {
      "Type": "AWS::Route53Resolver::FirewallConfig",
      "DependsOn": "DNSFirewallAssociation",
      "Properties": {
        "ResourceId": {
          "Ref": "VpcId"
        },
        "FirewallFailOpen": "DISABLED"
      }
    },
    "ResolvedDomainRuleGroup": {
      "Type": "AWS::NetworkFirewall::RuleGroup",
      "Properties": {
        "RuleGroupName": {
          "Fn::Sub": "${AWS::StackName}-resolved-domain-allowlist"
        },
        "Capacity": 100,
        "Description": "Require TLS SNI or HTTP Host and Route 53 resolved destination domain to match the approved allowlist.",
        "RuleGroup": {
          "RulesSource": {
            "RulesSourceList": {
              "Targets": {
                "Ref": "ApprovedDomains"
              },
              "TargetTypes": [
                "TLS_SNI",
                "HTTP_HOST",
                "AWS_ROUTE_53_RESOLVED_DOMAIN"
              ],
              "GeneratedRulesType": "ALLOWLIST"
            }
          },
          "StatefulRuleOptions": {
            "RuleOrder": "STRICT_ORDER"
          }
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ],
        "Type": "STATEFUL"
      }
    },
    "FirewallPolicy": {
      "Type": "AWS::NetworkFirewall::FirewallPolicy",
      "Properties": {
        "FirewallPolicyName": {
          "Fn::Sub": "${AWS::StackName}-egress-policy"
        },
        "Description": "Fail-closed single-AZ FCP-03 egress policy.",
        "FirewallPolicy": {
          "StatelessDefaultActions": [
            "aws:forward_to_sfe"
          ],
          "StatelessFragmentDefaultActions": [
            "aws:forward_to_sfe"
          ],
          "StatefulRuleGroupReferences": [
            {
              "ResourceArn": {
                "Fn::GetAtt": [
                  "ManagementSshRuleGroup",
                  "RuleGroupArn"
                ]
              },
              "Priority": 1
            },
            {
              "ResourceArn": {
                "Fn::GetAtt": [
                  "ResolvedDomainRuleGroup",
                  "RuleGroupArn"
                ]
              },
              "Priority": 10
            }
          ],
          "StatefulEngineOptions": {
            "RuleOrder": "STRICT_ORDER"
          },
          "StatefulDefaultActions": [
            "aws:drop_strict"
          ],
          "Route53ResolvedIPValidation": {
            "DNSFirewallRuleGroupId": {
              "Ref": "DNSFirewallRuleGroup"
            },
            "Action": "DROP",
            "DNSExpiryExceptionPolicy": "DROP",
            "SourceIPRanges": [
              {
                "AddressDefinition": {
                  "Ref": "WorkerSubnetCidr"
                }
              }
            ],
            "BypassDestinationValidationIPRanges": []
          }
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "NetworkFirewall": {
      "Type": "AWS::NetworkFirewall::Firewall",
      "DependsOn": "FirewallDefaultRoute",
      "Properties": {
        "FirewallName": {
          "Fn::Sub": "${AWS::StackName}-egress"
        },
        "FirewallPolicyArn": {
          "Fn::GetAtt": [
            "FirewallPolicy",
            "FirewallPolicyArn"
          ]
        },
        "VpcId": {
          "Ref": "VpcId"
        },
        "SubnetMappings": [
          {
            "SubnetId": {
              "Ref": "FirewallSubnet"
            }
          }
        ],
        "DeleteProtection": false,
        "FirewallPolicyChangeProtection": false,
        "SubnetChangeProtection": false,
        "AvailabilityZoneChangeProtection": false,
        "Description": "Disposable FCP-03 one-AZ egress enforcement lab.",
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "FirewallLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/network-firewall/${AWS::StackName}"
        },
        "RetentionInDays": 7
      }
    },
    "NetworkFirewallLogging": {
      "Type": "AWS::NetworkFirewall::LoggingConfiguration",
      "DependsOn": "NetworkFirewall",
      "Properties": {
        "FirewallArn": {
          "Ref": "NetworkFirewall"
        },
        "LoggingConfiguration": {
          "LogDestinationConfigs": [
            {
              "LogType": "FLOW",
              "LogDestinationType": "CloudWatchLogs",
              "LogDestination": {
                "logGroup": {
                  "Ref": "FirewallLogGroup"
                }
              }
            },
            {
              "LogType": "ALERT",
              "LogDestinationType": "CloudWatchLogs",
              "LogDestination": {
                "logGroup": {
                  "Ref": "FirewallLogGroup"
                }
              }
            }
          ]
        }
      }
    },
    "WorkerDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "NetworkFirewall",
      "Properties": {
        "RouteTableId": {
          "Ref": "WorkerRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "VpcEndpointId": {
          "Fn::Select": [
            1,
            {
              "Fn::Split": [
                ":",
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::GetAtt": [
                        "NetworkFirewall",
                        "EndpointIds"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "WorkerInstance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "WorkerDefaultRoute",
        "WorkerRouteToController",
        "DNSFirewallAssociation",
        "DNSFirewallConfig",
        "NetworkFirewallLogging",
        "AutomaticTeardown",
        "PublicReturnRoute",
        "PublicRouteTableAssociation",
        "WorkerNetworkAclAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "WorkerAmiId"
        },
        "InstanceType": {
          "Ref": "WorkerInstanceType"
        },
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WorkerSecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpEndpoint": "disabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "InstanceMetadataTags": "disabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker"
            }
          },
          {
            "Key": "Project",
            "Value": "Tinlance"
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          },
          {
            "Key": "TestScope",
            "Value": "isolated-egress-enforcement"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\ninstall -d -m 0700 -o ec2-user -g ec2-user /home/ec2-user/.ssh\ncat > /home/ec2-user/.ssh/authorized_keys <<'TINLANCE_FCP03_KEY'\n${ControllerPublicKey}\nTINLANCE_FCP03_KEY\nchown ec2-user:ec2-user /home/ec2-user/.ssh/authorized_keys\nchmod 0600 /home/ec2-user/.ssh/authorized_keys\n"
          }
        }
      }
    },
    "TeardownRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule/default/tinlance-fcp03-auto-teardown"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeleteOnlyThisFcp03LabStack",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DeleteStack"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${AWS::StackName}/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "AutomaticTeardown": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": "tinlance-fcp03-auto-teardown",
        "Description": "Deletes the entire disposable FCP-03 lab at the required UTC deadline.",
        "ScheduleExpression": {
          "Fn::Sub": "at(${TeardownAtUtc})"
        },
        "ScheduleExpressionTimezone": "UTC",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": "arn:aws:scheduler:::aws-sdk:cloudformation:deleteStack",
          "RoleArn": {
            "Fn::GetAtt": [
              "TeardownRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"StackName\":\"${AWS::StackName}\"}"
          }
        }
      }
    },
    "PublicReturnRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "NetworkFirewall",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": {
          "Ref": "WorkerSubnetCidr"
        },
        "VpcEndpointId": {
          "Fn::Select": [
            1,
            {
              "Fn::Split": [
                ":",
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::GetAtt": [
                        "NetworkFirewall",
                        "EndpointIds"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "WorkerNetworkAcl": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "WorkerNetworkAclAssociation": {
      "Type": "AWS::EC2::SubnetNetworkAclAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        }
      },
      "DependsOn": [
        "WorkerNaclEgressDnsUdp",
        "WorkerNaclEgressDnsTcp",
        "WorkerNaclEgressSshReturn",
        "WorkerNaclEgressDenyVpc",
        "WorkerNaclEgressHttps",
        "WorkerNaclEgressDenyRest",
        "WorkerNaclIngressSsh",
        "WorkerNaclIngressTcpEphemeral",
        "WorkerNaclIngressUdpEphemeral",
        "WorkerNaclIngressDenyRest"
      ]
    },
    "WorkerNaclEgressDnsUdp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 90,
        "Protocol": "17",
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Fn::Sub": "${VpcResolverIp}/32"
        },
        "PortRange": {
          "From": 53,
          "To": 53
        }
      }
    },
    "WorkerNaclEgressDnsTcp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 91,
        "Protocol": "6",
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Fn::Sub": "${VpcResolverIp}/32"
        },
        "PortRange": {
          "From": 53,
          "To": 53
        }
      }
    },
    "WorkerNaclEgressDenyVpc": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 100,
        "Protocol": "-1",
        "RuleAction": "deny",
        "Egress": true,
        "CidrBlock": {
          "Ref": "VpcCidr"
        }
      }
    },
    "WorkerNaclEgressHttps": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 110,
        "Protocol": "6",
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": "0.0.0.0/0",
        "PortRange": {
          "From": 443,
          "To": 443
        }
      }
    },
    "WorkerNaclEgressDenyRest": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 32766,
        "Protocol": "-1",
        "RuleAction": "deny",
        "Egress": true,
        "CidrBlock": "0.0.0.0/0"
      }
    },
    "WorkerNaclIngressTcpEphemeral": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 100,
        "Protocol": "6",
        "RuleAction": "allow",
        "Egress": false,
        "CidrBlock": "0.0.0.0/0",
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    },
    "WorkerNaclIngressUdpEphemeral": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 110,
        "Protocol": "17",
        "RuleAction": "allow",
        "Egress": false,
        "CidrBlock": "0.0.0.0/0",
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    },
    "WorkerNaclIngressDenyRest": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 32766,
        "Protocol": "-1",
        "RuleAction": "deny",
        "Egress": false,
        "CidrBlock": "0.0.0.0/0"
      }
    },
    "ManagementSshRuleGroup": {
      "Type": "AWS::NetworkFirewall::RuleGroup",
      "Properties": {
        "RuleGroupName": {
          "Fn::Sub": "${AWS::StackName}-controller-ssh"
        },
        "Capacity": 10,
        "Description": "Allow only the existing trusted controller to SSH to the disposable worker through the same-AZ firewall endpoint.",
        "RuleGroup": {
          "RulesSource": {
            "RulesString": {
              "Fn::Sub": "pass tcp ${ControllerPrivateIp}/32 any -> ${WorkerSubnetCidr} 22 (msg:\"FCP-03 trusted controller SSH management\"; sid:100; rev:1;)"
            }
          },
          "StatefulRuleOptions": {
            "RuleOrder": "STRICT_ORDER"
          }
        },
        "Type": "STATEFUL",
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "WorkerRouteToController": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "WorkerRouteTable"
        },
        "DestinationCidrBlock": {
          "Fn::Sub": "${ControllerPrivateIp}/32"
        },
        "VpcEndpointId": {
          "Fn::Select": [
            1,
            {
              "Fn::Split": [
                ":",
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::GetAtt": [
                        "NetworkFirewall",
                        "EndpointIds"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "DependsOn": "NetworkFirewall"
    },
    "WorkerNaclEgressSshReturn": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 95,
        "Protocol": "6",
        "RuleAction": "allow",
        "Egress": true,
        "CidrBlock": {
          "Fn::Sub": "${ControllerPrivateIp}/32"
        },
        "PortRange": {
          "From": 1024,
          "To": 65535
        }
      }
    },
    "WorkerNaclIngressSsh": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 90,
        "Protocol": "6",
        "RuleAction": "allow",
        "Egress": false,
        "CidrBlock": {
          "Fn::Sub": "${ControllerPrivateIp}/32"
        },
        "PortRange": {
          "From": 22,
          "To": 22
        }
      }
    }
  },
  "Outputs": {
    "WorkerInstanceId": {
      "Value": {
        "Ref": "WorkerInstance"
      }
    },
    "WorkerPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "WorkerInstance",
          "PrivateIp"
        ]
      }
    },
    "NetworkFirewallArn": {
      "Value": {
        "Fn::GetAtt": [
          "NetworkFirewall",
          "FirewallArn"
        ]
      }
    },
    "AutomaticTeardownAtUtc": {
      "Value": {
        "Ref": "TeardownAtUtc"
      }
    },
    "SafetyNote": {
      "Value": "One AZ only. Worker has no public IP or IPv6. Stack self-deletes at the required UTC time. Deployment still requires a separate cost and test approval."
    }
  }
}
