{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Single-AZ disposable FCP-03 egress enforcement lab. Requires a bounded UTC teardown time; never deploy into a production VPC.",
  "Parameters": {
    "AvailabilityZone": {
      "Type": "AWS::EC2::AvailabilityZone::Name",
      "Description": "One AZ only. The single endpoint is selected deterministically from Network Firewall EndpointIds."
    },
    "ApprovedDomains": {
      "Type": "CommaDelimitedList",
      "Description": "Exact approved FQDNs for the worker's bounded DNS and HTTPS smoke probes; the worker has no SSM or instance-profile dependency."
    },
    "TeardownAtUtc": {
      "Type": "String",
      "Description": "Required UTC timestamp YYYY-MM-DDTHH:MM:SS. Validate with scripts/validate_fcp03_teardown_at.py; must be 15 minutes to 2 hours after deployment."
    },
    "WorkerInstanceType": {
      "Type": "String",
      "Default": "t4g.medium",
      "AllowedValues": [
        "t4g.micro",
        "t4g.small",
        "t4g.medium"
      ]
    },
    "WorkerAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
    },
    "VpcCidr": {
      "Type": "String",
      "Default": "10.42.0.0/16",
      "AllowedValues": [
        "10.42.0.0/16"
      ]
    },
    "PublicSubnetCidr": {
      "Type": "String",
      "Default": "10.42.0.0/24"
    },
    "FirewallSubnetCidr": {
      "Type": "String",
      "Default": "10.42.1.0/24"
    },
    "WorkerSubnetCidr": {
      "Type": "String",
      "Default": "10.42.2.0/24"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": {
          "Ref": "VpcCidr"
        },
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Tinlance"
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "InternetGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "CidrBlock": {
          "Ref": "PublicSubnetCidr"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-nat"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "FirewallSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "CidrBlock": {
          "Ref": "FirewallSubnetCidr"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-firewall"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WorkerSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "CidrBlock": {
          "Ref": "WorkerSubnetCidr"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker-private"
            }
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "FirewallRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "WorkerRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "FirewallRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "FirewallSubnet"
        },
        "RouteTableId": {
          "Ref": "FirewallRouteTable"
        }
      }
    },
    "WorkerRouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "RouteTableId": {
          "Ref": "WorkerRouteTable"
        }
      }
    },
    "PublicDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "NatEip": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "DependsOn": "PublicDefaultRoute",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatEip",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet"
        },
        "ConnectivityType": "public",
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "FirewallDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "NatGateway",
      "Properties": {
        "RouteTableId": {
          "Ref": "FirewallRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatGateway"
        }
      }
    },
    "WorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "FCP-03 worker: no ingress; DNS only to VPC resolver; HTTPS egress is inspected by Network Firewall.",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS routed through Network Firewall"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": "10.42.0.2/32",
            "Description": "VPC Resolver only"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": "10.42.0.2/32",
            "Description": "VPC Resolver TCP fallback only"
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "ApprovedDnsDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-approved-dns"
        },
        "Domains": {
          "Ref": "ApprovedDomains"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "WildcardDnsDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-all-dns"
        },
        "Domains": [
          "*"
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "DNSFirewallRuleGroup": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-dns-allowlist"
        },
        "FirewallRules": [
          {
            "Action": "ALLOW",
            "FirewallDomainListId": {
              "Fn::GetAtt": [
                "ApprovedDnsDomainList",
                "Id"
              ]
            },
            "Priority": 100
          },
          {
            "Action": "BLOCK",
            "BlockResponse": "NXDOMAIN",
            "FirewallDomainListId": {
              "Fn::GetAtt": [
                "WildcardDnsDomainList",
                "Id"
              ]
            },
            "Priority": 200
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "DNSFirewallAssociation": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroupAssociation",
      "Properties": {
        "FirewallRuleGroupId": {
          "Ref": "DNSFirewallRuleGroup"
        },
        "VpcId": {
          "Ref": "Vpc"
        },
        "Priority": 101,
        "MutationProtection": "DISABLED",
        "Name": {
          "Fn::Sub": "${AWS::StackName}-dns-association"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "DNSFirewallConfig": {
      "Type": "AWS::Route53Resolver::FirewallConfig",
      "DependsOn": "DNSFirewallAssociation",
      "Properties": {
        "ResourceId": {
          "Ref": "Vpc"
        },
        "FirewallFailOpen": "DISABLED"
      }
    },
    "ResolvedDomainRuleGroup": {
      "Type": "AWS::NetworkFirewall::RuleGroup",
      "Properties": {
        "RuleGroupName": {
          "Fn::Sub": "${AWS::StackName}-resolved-domain-allowlist"
        },
        "Capacity": 100,
        "Description": "Require TLS SNI or HTTP Host and Route 53 resolved destination domain to match the approved allowlist.",
        "RuleGroup": {
          "RulesSource": {
            "RulesSourceList": {
              "Targets": {
                "Ref": "ApprovedDomains"
              },
              "TargetTypes": [
                "TLS_SNI",
                "HTTP_HOST",
                "AWS_ROUTE_53_RESOLVED_DOMAIN"
              ],
              "GeneratedRulesType": "ALLOWLIST"
            }
          },
          "StatefulRuleOptions": {
            "RuleOrder": "STRICT_ORDER"
          }
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ],
        "Type": "STATEFUL"
      }
    },
    "FirewallPolicy": {
      "Type": "AWS::NetworkFirewall::FirewallPolicy",
      "Properties": {
        "FirewallPolicyName": {
          "Fn::Sub": "${AWS::StackName}-egress-policy"
        },
        "Description": "Fail-closed single-AZ FCP-03 egress policy.",
        "FirewallPolicy": {
          "StatelessDefaultActions": [
            "aws:forward_to_sfe"
          ],
          "StatelessFragmentDefaultActions": [
            "aws:forward_to_sfe"
          ],
          "StatefulRuleGroupReferences": [
            {
              "ResourceArn": {
                "Fn::GetAtt": [
                  "ResolvedDomainRuleGroup",
                  "RuleGroupArn"
                ]
              },
              "Priority": 1
            }
          ],
          "StatefulEngineOptions": {
            "RuleOrder": "STRICT_ORDER"
          },
          "StatefulDefaultActions": [
            "aws:drop_strict"
          ],
          "Route53ResolvedIPValidation": {
            "DNSFirewallRuleGroupId": {
              "Ref": "DNSFirewallRuleGroup"
            },
            "Action": "DROP",
            "DNSExpiryExceptionPolicy": "DROP",
            "SourceIPRanges": [
              {
                "AddressDefinition": {
                  "Ref": "WorkerSubnetCidr"
                }
              }
            ],
            "BypassDestinationValidationIPRanges": []
          }
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "NetworkFirewall": {
      "Type": "AWS::NetworkFirewall::Firewall",
      "DependsOn": "FirewallDefaultRoute",
      "Properties": {
        "FirewallName": {
          "Fn::Sub": "${AWS::StackName}-egress"
        },
        "FirewallPolicyArn": {
          "Fn::GetAtt": [
            "FirewallPolicy",
            "FirewallPolicyArn"
          ]
        },
        "VpcId": {
          "Ref": "Vpc"
        },
        "SubnetMappings": [
          {
            "SubnetId": {
              "Ref": "FirewallSubnet"
            }
          }
        ],
        "DeleteProtection": false,
        "FirewallPolicyChangeProtection": false,
        "SubnetChangeProtection": false,
        "AvailabilityZoneChangeProtection": false,
        "Description": "Disposable FCP-03 one-AZ egress enforcement lab.",
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "FirewallLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/network-firewall/${AWS::StackName}"
        },
        "RetentionInDays": 7
      }
    },
    "NetworkFirewallLogging": {
      "Type": "AWS::NetworkFirewall::LoggingConfiguration",
      "DependsOn": "NetworkFirewall",
      "Properties": {
        "FirewallArn": {
          "Ref": "NetworkFirewall"
        },
        "LoggingConfiguration": {
          "LogDestinationConfigs": [
            {
              "LogType": "FLOW",
              "LogDestinationType": "CloudWatchLogs",
              "LogDestination": {
                "logGroup": {
                  "Ref": "FirewallLogGroup"
                }
              }
            },
            {
              "LogType": "ALERT",
              "LogDestinationType": "CloudWatchLogs",
              "LogDestination": {
                "logGroup": {
                  "Ref": "FirewallLogGroup"
                }
              }
            }
          ]
        }
      }
    },
    "WorkerDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "NetworkFirewall",
      "Properties": {
        "RouteTableId": {
          "Ref": "WorkerRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "VpcEndpointId": {
          "Fn::Select": [
            1,
            {
              "Fn::Split": [
                ":",
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::GetAtt": [
                        "NetworkFirewall",
                        "EndpointIds"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "WorkerInstance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "WorkerDefaultRoute",
        "DNSFirewallAssociation",
        "DNSFirewallConfig",
        "NetworkFirewallLogging",
        "AutomaticTeardown",
        "PublicReturnRoute",
        "WorkerNetworkAclAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "WorkerAmiId"
        },
        "InstanceType": {
          "Ref": "WorkerInstanceType"
        },
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WorkerSecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpEndpoint": "disabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "InstanceMetadataTags": "disabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-worker"
            }
          },
          {
            "Key": "Project",
            "Value": "Tinlance"
          },
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          },
          {
            "Key": "TestScope",
            "Value": "isolated-egress-enforcement"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": [
              "#!/bin/bash\nset -u\nexec > >(tee /dev/console | logger -t fcp03-bootstrap -s 2>/dev/console) 2>&1\nprintf '%s\\n' 'FCP03_BOOTSTRAP_START metadata_endpoint=disabled instance_profile=none'\nprintf '%s\\n' 'FCP03_TEST_DNS_BEGIN'\nif getent ahostsv4 '${ApprovedProbeDomain}' >/dev/null 2>&1; then printf '%s\\n' 'FCP03_TEST_DNS_APPROVED=PASS'; else printf '%s\\n' 'FCP03_TEST_DNS_APPROVED=FAIL'; fi\nprintf '%s\\n' 'FCP03_TEST_HTTPS_APPROVED_BEGIN'\nif timeout 12 curl --fail --silent --show-error --connect-timeout 5 --max-time 10 'https://${ApprovedProbeDomain}/' -o /dev/null; then printf '%s\\n' 'FCP03_TEST_HTTPS_APPROVED=PASS'; else printf '%s\\n' 'FCP03_TEST_HTTPS_APPROVED=FAIL'; fi\nprintf '%s\\n' 'FCP03_TEST_DIRECT_IP_BEGIN'\nif timeout 8 curl --insecure --silent --show-error --connect-timeout 3 --max-time 6 'https://1.1.1.1/' -o /dev/null; then printf '%s\\n' 'FCP03_TEST_DIRECT_IP=UNEXPECTED_PASS'; else printf '%s\\n' 'FCP03_TEST_DIRECT_IP=INCONCLUSIVE_REQUIRES_FLOW_EVIDENCE'; fi\nprintf '%s\\n' 'FCP03_BOOTSTRAP_COMPLETE retrieve_with_ec2_get_console_output=true'",
              {
                "ApprovedProbeDomain": {
                  "Fn::Select": [
                    0,
                    {
                      "Ref": "ApprovedDomains"
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "TeardownRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule/default/tinlance-fcp03-auto-teardown"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeleteOnlyThisFcp03LabStack",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DeleteStack"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${AWS::StackName}/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          }
        ]
      }
    },
    "AutomaticTeardown": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": "tinlance-fcp03-auto-teardown",
        "Description": "Deletes the entire disposable FCP-03 lab at the required UTC deadline.",
        "ScheduleExpression": {
          "Fn::Sub": "at(${TeardownAtUtc})"
        },
        "ScheduleExpressionTimezone": "UTC",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": "arn:aws:scheduler:::aws-sdk:cloudformation:deleteStack",
          "RoleArn": {
            "Fn::GetAtt": [
              "TeardownRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"StackName\":\"${AWS::StackName}\"}"
          }
        }
      }
    },
    "PublicReturnRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "NetworkFirewall",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": {
          "Ref": "WorkerSubnetCidr"
        },
        "VpcEndpointId": {
          "Fn::Select": [
            1,
            {
              "Fn::Split": [
                ":",
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::GetAtt": [
                        "NetworkFirewall",
                        "EndpointIds"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "WorkerNetworkAcl": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "FCPPhase",
            "Value": "FCP-03"
          },
          {
            "Key": "Environment",
            "Value": "disposable-test"
          }
        ]
      }
    },
    "WorkerNetworkAclAssociation": {
      "Type": "AWS::EC2::SubnetNetworkAclAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "WorkerSubnet"
        },
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        }
      },
      "DependsOn": [
        "WorkerNaclEgressDnsUdp",
        "WorkerNaclEgressDnsTcp",
        "WorkerNaclEgressDenyVpc",
        "WorkerNaclEgressHttps",
        "WorkerNaclEgressDenyRest",
        "WorkerNaclIngressTcpEphemeral",
        "WorkerNaclIngressUdpEphemeral",
        "WorkerNaclIngressDenyRest"
      ]
    },
    "WorkerNaclEgressDnsUdp": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "WorkerNetworkAcl"
        },
        "RuleNumber": 90,
        "Protocol": "17",
        "RuleAction": "allow",
